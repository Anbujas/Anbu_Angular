# Copy this file to .env and fill in real values to enable actual email delivery.
# Without these set, inquiries are validated and logged to the console, and the
# API still returns success — useful for local development and testing.

# Example values for sending via a Gmail account (use an App Password, not your
# real password: https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Optional overrides:
FROM_EMAIL=your-email@gmail.com
CONTACT_TO_EMAIL=anbujas18@gmail.com
